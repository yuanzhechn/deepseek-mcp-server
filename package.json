{
  "name": "deepseek-mcp-server",
  "version": "1.4.1",
  "mcpName": "io.github.DMontgomery40/deepseek",
  "description": "MCP server for DeepSeek Flash vision, Pro chat, Responses, FIM, Files, models, and balance APIs.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "deepseek-mcp-server": "build/index.js",
    "collab": "build/cli/collab.js"
  },
  "files": [
    "build/**/*",
    "assets/favicon.ico",
    "assets/favicon-32x32.png",
    "assets/apple-touch-icon.png",
    "src/docs/*.md",
    "src/docs/*.txt",
    "docs/collaboration/**/*",
    "skills/collab-mode/SKILL.md",
    "AGENTS.md",
    "start-collab-dashboard.cmd"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test": "npm run build && vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "test:remote": "npm run build && node scripts/remote-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "collab": "node build/cli/collab.js",
    "dashboard": "npm run build && node build/cli/collab.js dashboard --open",
    "prepublishOnly": "npm run build",
    "inspect": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "author": "DMontgomery40",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMontgomery40/deepseek-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "deepseek",
    "ai",
    "llm"
  ]
}
